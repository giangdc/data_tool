# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Tài khoản nhập được trên giao diện lần đầu (tool tự lưu vào .env), không cần sửa tay.

# Môi trường (xem config/environments.js). Hiện có: stag
SOP_ENV=stag

# ---- Tài khoản Portal SOP (đăng nhập qua https://portal-sop-stg.fpt.vn/user/login/basic-auth)
SOP_USER=
SOP_PASSWORD=

# ---- Dữ liệu mặc định của đơn (sửa được trên giao diện)
# SĐT khách hàng có sẵn trong "Khách hàng của tôi"
DEFAULT_PHONE=
# Địa chỉ lắp đặt – gõ vào ô Tìm kiếm trên bản đồ, lấy kết quả đầu tiên
DEFAULT_ADDRESS=123, Trương Định, Phường Bến Thành, Hồ Chí Minh
# Combo gợi ý: GigaF1 | GigaF2 | MetaF1 | MetaF2 | SkyF1 | SkyF2 ; gói thứ mấy trong combo (1-6)
DEFAULT_COMBO=GigaF1
DEFAULT_COMBO_INDEX=1
# Phương thức thanh toán (mặc định của portal "FRT Thu Hộ" bị stag báo không hỗ trợ)
DEFAULT_PAYMENT=Napas

# ---- Kỹ thuật
# true = chạy ẩn trình duyệt; false = hiện cửa sổ Chrome để theo dõi
HEADLESS=false
# Trình duyệt: auto (Chrome → Edge → Chromium) | chrome | msedge | chromium
BROWSER=auto

# Cổng giao diện web (npm run ui). FTMS 3000, FPT.vn 3001, FPL/CRM 3002, Bill Detail 3003, GH quầy 3004
UI_PORT=3005
