# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
CRM_ENV=stag

# Mật khẩu tài khoản CRM stag (tenant FTEL). Nhập được trên giao diện lần đầu
CRM_PASSWORD=

# Domain email ghép vào khi chỉ nhập tên tài khoản (vd: stag_hoangnv75 -> stag_hoangnv75@fpt.com)
CRM_EMAIL_DOMAIN=fpt.com

# Tài khoản đăng nhập mặc định (để trống thì nhập trên giao diện / -u ở CLI)
CRM_USER=

# Cơ hội mẫu để copy (mã CH, link hoặc id). Để trống = cơ hội mẫu mặc định trong config/environments.js
CRM_SAMPLE_OPP=

# Tiền tố gắn vào tên cơ hội / khách hàng để dễ nhận biết & dọn dữ liệu
DATA_PREFIX=AUTO-QC

# Thời gian tối đa (phút) chờ chính sách báo giá "Đã ban hành" trước khi tạo đơn hàng
ORDER_WAIT_MINUTES=10

# Cổng giao diện web (npm run ui). FTMS Data Tool dùng 3000, FPT.vn Order Tool dùng 3001
UI_PORT=3002
