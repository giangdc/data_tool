# Copy file này thành .env. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
TMDT_ENV=stag

# Cổng giao diện web (các tool khác dùng 3000-3008)
UI_PORT=3009

# Access Token đăng nhập SPF Web Admin (ô "Token" ở trang Login). Có thể bỏ trống và dán trên UI / `npm run login -- --token ...`
# Token nhập trên UI được lưu ở .cache/session.json để tự đăng nhập lại khi hết phiên.
SPF_ACCESS_TOKEN=

# Mặc định form (đặt lại được bằng nút ☆ trên UI)
DEFAULT_SOURCE=Tiktok
DEFAULT_PHONE=0868650892
# Hồ Chí Minh (8) · Phường Phú Thuận (1000009764 / 1000107464) · Huỳnh Tấn Phát (1001003171)
DEFAULT_LOCATION_ID=8
DEFAULT_DISTRICT_ID=1000009764
DEFAULT_WARD_ID=1000107464
DEFAULT_STREET_ID=1001003171
DEFAULT_ADDRESS_NO=qc test
