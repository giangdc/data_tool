# Copy file này thành .env nếu muốn đổi mặc định. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
FPTVN_ENV=stag

# Proxy ra Internet khi gọi API apis-stag.fpt.vn. Bỏ trống = tự dùng proxy hệ thống (GNOME) rồi tới HTTPS_PROXY.
# Mạng công ty FPT: http://proxy.fpt.vn:80 · "none" = gọi thẳng
ECP_PROXY=

# Cổng giao diện web (npm run ui). Tool BMS dùng 3000 nên tool này mặc định 3001
UI_PORT=3001

# Giá trị mặc định của form tạo đơn (sửa được trên giao diện). SĐT + link gói đặt bằng nút "☆ Đặt mặc định" trên UI sẽ ưu tiên hơn
DEFAULT_URL=https://staging.fpt.vn/internet/goi-giga
DEFAULT_NAME=AUTO-QC Test
DEFAULT_PHONE=0964633310
DEFAULT_PROVINCE=Hồ Chí Minh
DEFAULT_WARD=Phường Bến Thành
DEFAULT_STREET=Trương Định
DEFAULT_ADDRESS_NO=123
DEFAULT_BUILDING=Tòa nhà VP 55 Nam Kỳ Khởi Nghĩa
DEFAULT_NOTE=AUTO-QC tạo đơn test

# Thẻ test cho tự thanh toán (khao-sat/pay-recorder.js tự ghi khi bạn nhập trên cổng thanh toán). KHÔNG commit
CARD_INTERNATIONAL_NUMBER=
CARD_INTERNATIONAL_NAME=
CARD_INTERNATIONAL_EXPIRY=
CARD_INTERNATIONAL_CVV=
CARD_INTERNATIONAL_OTP=
CARD_DOMESTIC_BANK=
CARD_DOMESTIC_NUMBER=
CARD_DOMESTIC_NAME=
CARD_DOMESTIC_ISSUE_DATE=
CARD_DOMESTIC_OTP=
# Thẻ dự phòng (thẻ 1 lỗi thì thử): CARD_<PTTT>_NUMBER2..5, các ô khác thêm hậu tố 2 nếu khác thẻ 1 (vd CARD_INTERNATIONAL_CVV2)
CARD_INTERNATIONAL_NUMBER2=
