# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
INSIDE_ENV=stag

# Tài khoản đăng nhập inside (form tài khoản + mật khẩu của login-stag.fpt.net, KHÔNG qua IAM)
INSIDE_USER=
INSIDE_PASSWORD=

# Mã OTP – chỉ điền nếu tài khoản bắt buộc OTP ("Sử dụng OTP" trên trang đăng nhập). Để trống = không dùng
INSIDE_OTP=

# Mã vùng gửi kèm khi tìm theo số hợp đồng (không ảnh hưởng kết quả, 8 = HCM)
LOCATION_ID=8

# Thời gian tối đa (giây) chờ API inside trả về. "Toàn bộ" năm của HĐ nhiều hóa đơn có thể mất ~15s
REQUEST_TIMEOUT_SEC=120

# Cổng giao diện web (npm run ui). FTMS 3000, FPT.vn 3001, FPL/CRM 3002
UI_PORT=3003
