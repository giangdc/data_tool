# Copy file này thành .env. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
BILLPAY_ENV=stag

# Proxy ra Internet khi gọi hifpt-api-stag.fpt.vn. Bỏ trống = tự dò (proxy GNOME -> HTTPS_PROXY)
# Mạng công ty FPT: http://proxy.fpt.vn:80 · "none" = gọi thẳng
BILLPAY_PROXY=

# Cổng giao diện web (các tool khác dùng 3000-3005)
UI_PORT=3006

# Mặc định form (đặt được bằng nút ☆ trên UI)
DEFAULT_CONTRACT=
DEFAULT_PAYMENT_METHOD=INTERNATIONAL

# Đường dẫn Chrome nếu không phải google-chrome
# CHROME_PATH=

# Thẻ test tự thanh toán (cùng cổng Foxpay/NAPAS với tool fpt.vn).
# Để trống -> tool tự lấy CARD_* từ ../Tao_DH/.env (hoặc ../FPL/.env)
CARD_INTERNATIONAL_NUMBER=
CARD_INTERNATIONAL_NAME=
CARD_INTERNATIONAL_EXPIRY=
CARD_INTERNATIONAL_CVV=
CARD_INTERNATIONAL_OTP=
CARD_DOMESTIC_BANK=
CARD_DOMESTIC_NUMBER=
CARD_DOMESTIC_NAME=
CARD_DOMESTIC_ISSUE_DATE=
CARD_DOMESTIC_OTP=
# Thẻ dự phòng: CARD_<PTTT>_NUMBER2..5 (+ ô khác hậu tố 2 nếu khác thẻ 1)
