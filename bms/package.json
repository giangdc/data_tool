{
  "name": "ftms-data-tool",
  "version": "1.5.0",
  "description": "Tool hỗ trợ QC tạo nhanh dữ liệu test trên hệ thống FTMS (BMS: tạo cơ hội, duyệt, khảo sát LeasedLine, YC HĐ, BGĐ duyệt HĐ)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "ftms-data": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "login": "node src/cli.js login",
    "create-opp": "node src/cli.js create-opp",
    "approve": "node src/cli.js approve",
    "survey": "node src/cli.js survey",
    "contract": "node src/cli.js contract",
    "approve-contract": "node src/cli.js approve-contract",
    "services": "node src/cli.js services",
    "setup": "npm install",
    "ui": "node src/server.js",
    "install-launcher": "bash scripts/install-launcher.sh",
    "build": "bash scripts/build-package.sh"
  },
  "dependencies": {
    "playwright-core": "1.62.0"
  }
}
