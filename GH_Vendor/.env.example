# Copy file này thành .env rồi điền giá trị (nếu cần). KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
GHV_ENV=stag

# ---- Tài khoản Fox ERP (KHÔNG bắt buộc)
# Để trống: lần đầu / khi phiên hết hạn, tool chờ bạn tự đăng nhập trong cửa sổ trình duyệt của tool (phiên được nhớ
# trong .cache/browser-profile). Điền vào: tool tự đăng nhập. Tài khoản phải thấy được ứng dụng "Quản lý NCU".
ERP_USER=
ERP_PASSWORD=

# Thời gian chờ bạn đăng nhập tay (phút)
LOGIN_WAIT_MIN=5

# ---- Popup "Xác nhận giao hàng" (bước Chưa giao hàng → Đang giao hàng). Sửa được trên giao diện.
# {code} = mã đơn hàng FTEL
INVOICE_NCU=HDNCU-{code}
INVOICE_FTEL=HDFTEL-{code}
# Tệp hoá đơn điện tử (đường dẫn). Để trống: tool tự tạo file PDF test trong output/invoices/
INVOICE_FILE=

# ---- Kỹ thuật
# Trình duyệt: auto (Chrome → Edge → Chromium) | chrome | msedge | chromium
BROWSER=auto
# Gắn vào Chrome đang mở sẵn (google-chrome --remote-debugging-port=9222) thay vì mở cửa sổ riêng
CDP_URL=
# Thời gian chờ danh sách phiếu giao hàng tải xong (giây) – hệ thống thường mất 1-2 phút
LIST_WAIT_SEC=240
# Chờ sau khi chọn tình trạng rồi mới bấm Xác nhận (giây). Bấm sớm thì hệ thống bỏ qua, không báo gì.
CONFIRM_DELAY_SEC=5
# Số trang (100 dòng/trang) tối đa lật để tìm phiếu
MAX_PAGES=5

# Cổng giao diện web (npm run ui). FTMS 3000, FPT.vn 3001, FPL/CRM 3002, Bill Detail 3003, GH quầy 3004
UI_PORT=3005
