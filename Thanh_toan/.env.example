# Copy file này thành .env rồi điền giá trị (nếu cần). KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
TT_ENV=stag

# ---- Thẻ quốc tế test (staging, xác thực 3DS Cardinal). Sửa được trên giao diện.
CARD_NUMBER=4000000000001091
CARD_NAME=NGUYEN VAN A
CARD_EXPIRY=12/26
CARD_CVV=111
CARD_OTP=1234
# ---- Thẻ nội địa test (Napas). Ngày phát hành MM/YY
DOMESTIC_CARD_NUMBER=9704000000000018
DOMESTIC_CARD_NAME=NGUYEN VAN A
DOMESTIC_CARD_ISSUE=03/07
DOMESTIC_CARD_OTP=otp

# SĐT chủ thẻ (popup "Xác nhận số điện thoại" trước khi sang cổng thanh toán)
PHONE=0868650892

# ---- Kỹ thuật
# Trình duyệt: auto (Chrome → Edge → Chromium) | chrome | msedge | chromium
BROWSER=auto
# Gắn vào Chrome đang mở sẵn (google-chrome --remote-debugging-port=9222) thay vì mở cửa sổ riêng
CDP_URL=
# Thời gian chờ tối đa mỗi bước (giây)
STEP_WAIT_SEC=60

# Cổng giao diện web (npm run ui). FTMS 3000, FPT.vn 3001, FPL/CRM 3002, Bill Detail 3003, GH quầy 3004, GH Vendor 3005
UI_PORT=3006
