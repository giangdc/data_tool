# Copy file này thành .env rồi điền giá trị (nếu cần). KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
GHQ_ENV=stag

# ---- Tài khoản (KHÔNG bắt buộc)
# Để trống: lần đầu / khi phiên hết hạn, tool chờ bạn tự đăng nhập trong cửa sổ trình duyệt của tool (phiên được nhớ
# trong .cache/browser-profile). Điền vào: tool tự đăng nhập.
# Fox ERP (Keycloak IAM) – tài khoản phải có quyền kho xuất bên dưới (vd ChuyenNT5; Vanmtt3 KHÔNG thấy kho KTNTESTMAC)
ERP_USER=
ERP_PASSWORD=
# Tool SCM (ftelscm-uat.fpt.net) – email đăng nhập
SCM_USER=
SCM_PASSWORD=
# GHTK lab (khachhang-staging.ghtklab.com) – shop có webhook trỏ về FPT
GHTK_USER=
GHTK_PASSWORD=

# Thời gian chờ bạn đăng nhập tay (phút)
LOGIN_WAIT_MIN=5

# ---- Dữ liệu mặc định của luồng (sửa được trên giao diện)
# Kho xuất bên Fox ERP = "Mã kho Inside" bên SCM
ERP_STOCK=KTNTESTMAC
# Tên kho đó bên SCM (combo Kho của SCM chỉ tìm được theo TÊN kho, không theo mã)
SCM_STOCK_NAME=Kho KTN test MAC
# SĐT kho (field bắt buộc bên "Thông tin kho xuất")
STOCK_PHONE=0775335608
# Phiếu nhập SCM
SCM_IMPORT_TYPE=Nhập khác
SCM_GOODS_STATE=Hàng mới
# Tích "Bảo hành v2" khi tìm phiếu tạm ứng
SCM_WARRANTY_V2=true
# Đơn vị vận chuyển ở Fox ERP
CARRIER=Giao hàng tiết kiệm
# Trạng thái GHTK đẩy ở bước cuối: 5 = Đã giao hàng/Chưa đối soát
GHTK_STATUS=5
# Nhận diện dòng webhook của FPT trong GHTK lab (Cấu hình API → Webhook)
GHTK_WEBHOOK_MATCH=apis-stag.fpt.vn

# Mã hàng SCM theo tên chủng loại (vật tư quản lý MAC). Chủng loại không có ở đây -> tool tìm theo tên.
ITEM_CODES=FPT Camera Play 4=20058112; FPT Camera IQ 4S=20055098
# Tiền tố MAC (hex, tuỳ chọn) – MAC còn lại sinh ngẫu nhiên cho đủ 12 ký tự hex
MAC_PREFIX=

# ---- Kỹ thuật
# Trình duyệt: auto (Chrome → Edge → Chromium) | chrome | msedge | chromium
BROWSER=auto
# Thời gian chờ đồng bộ giữa các hệ thống (giây): SCM → Fox ERP, GHTK → Fox ERP
SYNC_WAIT_SEC=120

# Cổng giao diện web (npm run ui). FTMS 3000, FPT.vn 3001, FPL/CRM 3002, Bill Detail 3003
UI_PORT=3004
