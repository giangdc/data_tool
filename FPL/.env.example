# Copy file này thành .env. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: dev
FPL_ENV=dev

# Proxy ra Internet khi gọi api-staging.fptplay.net. Bỏ trống = tự dò (proxy hệ thống GNOME / HTTPS_PROXY)
# Mạng công ty FPT: http://proxy.fpt.vn:80 · "none" = gọi thẳng
FPL_PROXY=

# Cổng giao diện web (BMS 3000, fpt.vn tool 3001)
UI_PORT=3002

# Tài khoản FPT Play mặc định + OTP mặc định môi trường dev (tool tự đăng nhập). Link gói đặt bằng nút ☆ trên UI
FPL_PHONE=0964633310
FPL_OTP=
DEFAULT_URL=https://dev.fptplay.vn/dich-vu/v-vip2?from_source=main

# Thẻ test tự thanh toán (cùng cổng Foxpay/NAPAS với tool fpt.vn – copy từ Tao_DH/.env)
CARD_INTERNATIONAL_NUMBER=
CARD_INTERNATIONAL_NAME=
CARD_INTERNATIONAL_EXPIRY=
CARD_INTERNATIONAL_CVV=
CARD_INTERNATIONAL_OTP=
CARD_DOMESTIC_BANK=
CARD_DOMESTIC_NUMBER=
CARD_DOMESTIC_NAME=
CARD_DOMESTIC_ISSUE_DATE=
CARD_DOMESTIC_OTP=
# Thẻ dự phòng: CARD_<PTTT>_NUMBER2..5 (+ ô khác hậu tố 2 nếu khác thẻ 1)
